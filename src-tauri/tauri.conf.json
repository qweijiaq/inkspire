{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkspire",
  "version": "0.1.0",
  "identifier": "com.inkspire.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Inkspire · 用墨点燃灵感",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "url": "index.html",
        "visibleOnAllWorkspaces": false
      },
      {
        "label": "pet",
        "title": "墨墨",
        "width": 240,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "url": "pet.html",
        "visibleOnAllWorkspaces": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "用墨点燃灵感的地方",
    "longDescription": "Inkspire 是本地优先的 Markdown 知识工作台：极速编辑、多格式导入、AI 建议态与墨墨桌宠。"
  }
}